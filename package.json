{
  "name": "@rayanfer32/atlas-md",
  "version": "4.1.0",
  "description": "Extensible WhatsApp bot framework with plugin support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/core/plugin.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "Plugins",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsup",
    "prepublishOnly": "npm run build",
    "test": "node --check index.js && tsc --noEmit",
    "test:db": "node --import tsx test-db.js",
    "start": "node --max-old-space-size=8000 --expose-gc --import tsx index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantoX/Atlas-MD.git"
  },
  "keywords": [
    "bot",
    "whatsapp bot",
    "whatsapp",
    "baileys",
    "baileys bot",
    "md bot"
  ],
  "author": "FantoX",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FantoX/Atlas-MD/issues"
  },
  "homepage": "https://github.com/FantoX/Atlas-MD#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@fantox01/lyrics-scraper": "latest",
    "@fantox01/search-it": "^1.0.0",
    "@google/genai": "^0.7.0",
    "@hapi/boom": "^10.0.1",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "axios": "^1.14.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "figlet": "^1.11.0",
    "file-type": "^22.0.0",
    "form-data": "^4.0.5",
    "link-preview-js": "^3.0.0",
    "moment-timezone": "^0.6.1",
    "mongoose": "^9.3.3",
    "node-cron": "^4.2.1",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "pm2": "^6.0.14",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.22.4",
    "uuid": "^13.0.0",
    "wa-sticker-formatter": "^4.4.4",
    "ws": "^8.20.0",
    "youtube-yts": "^2.0.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "simple-xml-to-json": "1.2.1"
  }
}
