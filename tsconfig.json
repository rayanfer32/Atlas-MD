{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "Plugins/**/*",
    "System/**/*",
    "core/**/*",
    "types/**/*",
    "index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
